{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/bai-hat/:path*", "destination": "/index.html" },
    { "source": "/kho-nhac", "destination": "/index.html" },
    { "source": "/tat-ca-bai-hat", "destination": "/index.html" },
    { "source": "/da-lab", "destination": "/index.html" },
    { "source": "/da-lab-classics", "destination": "/index.html" },
    { "source": "/solo", "destination": "/index.html" },
    { "source": "/bai-rieng", "destination": "/index.html" },
    { "source": "/underground", "destination": "/index.html" },
    { "source": "/soundcloud", "destination": "/index.html" },
    { "source": "/dong-thoi-gian", "destination": "/index.html" },
    { "source": "/artist-chronology", "destination": "/index.html" },
    { "source": "/ghi-chu", "destination": "/index.html" },
    { "source": "/loi-bai-hat-and-ghi-chu", "destination": "/index.html" },
    { "source": "/ve-emcee-l", "destination": "/index.html" },
    { "source": "/chinh-sach", "destination": "/index.html" },
    { "source": "/dieu-khoan-luu-tru", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.(js|css|woff|woff2|svg|jpg|jpeg|png|mp3|m4a|ogg|wav))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
